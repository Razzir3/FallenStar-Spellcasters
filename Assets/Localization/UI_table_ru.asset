    m_Metadata:
      m_Items:
      - rid: 564089522111119449
  - m_Id: 10388984159825920
    m_Localized: "{0} \u0438\u0433\u0440\u043E\u043A. \u0425\u043E\u0434 \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items:
      - rid: 564089522111119449
  - m_Id: 10389089290055680
    m_Localized: "Возрождается: "
    m_Metadata:
      m_Items: []
  - m_Id: 10389174614781952
    m_Localized: "{0} \u0438\u0433\u0440\u043E\u043A. \u042D\u0442\u043E \u0432\u044B"
    m_Metadata:
      m_Items:
      - rid: 564089522111119449
  - m_Id: 10389274019786752
    m_Localized: "{0} \u0438\u0433\u0440\u043E\u043A. \u042D\u0442\u043E \u043E\u043F\u043F\u043E\u043D\u0435\u043D\u0442"
    m_Metadata:
      m_Items:
      - rid: 564089522111119449
  - m_Id: 12897104371150848
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12897129557946368
    m_Localized: "\u0412\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 49584400148267008
    m_Localized: "\u0418\u0433\u0440\u0430 \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 49717325267271680
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 49717325317603328
    m_Localized: "\u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 49717325317603329
    m_Localized: "\u041D\u0438\u0447\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 49717325317603330
    m_Localized: "\u0412\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0441\u0435
      \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49717325317603331
    m_Localized: "\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u0432\u0441\u0435 \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49717325317603332
    m_Localized: "\u041E\u0431\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0441\u0435 \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 49717325317603333
    m_Localized: "\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u043F\u043E\u043A\u0438\u043D\u0443\u043B
      \u043C\u0430\u0442\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 49717325317603334
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 49726419487227904
    m_Localized: "\u041C\u0430\u043D\u0430 : {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 49727086813577216
    m_Localized: "\u041C\u0430\u043D\u0430 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430
      : {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 49727086813577217
    m_Localized: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 49867087845064704
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043C\u0430\u0442\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 49867087916367872
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043C\u0430\u0442\u0447?
      \u042D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043D\u043E
      \u043A\u0430\u043A \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 49867087916367873
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 49867087916367874
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 49867087916367875
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438 \u043C\u0430\u0442\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 50130220824199168
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 50130221755334656
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 50130222338342912
    m_Localized: "\u042F\u0437\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 50130222971682816
    m_Localized: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0435
      \u043B\u043E\u0431\u0431\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 50130223584051200
    m_Localized: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u0438\u0433\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 50130224179642368
    m_Localized: "\u041B\u0438\u043C\u0438\u0442 \u0440\u0443\u043A\u0438: \u0441\u0430\u043C\u0430\u044F
      \u0441\u0442\u0430\u0440\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 50768243265961984
    m_Localized: "\u0420\u0435\u0436\u0438\u043C \u044D\u043A\u0440\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409536
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409537
    m_Localized: "\u041F\u043E\u043B\u043D\u043E\u044D\u043A\u0440\u0430\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409538
    m_Localized: "\u041E\u043A\u043E\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409539
    m_Localized: "Соединение с хостом потеряно."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409540
    m_Localized: "Матч не удалось продолжить, он отменён."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409541
    m_Localized: "Не удалось войти. Проверьте подключение и попробуйте снова."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409542
    m_Localized: "Не удалось создать лобби. Проверьте подключение и попробуйте снова."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409543
    m_Localized: "Не удалось войти в лобби. Возможно, оно заполнено или закрыто."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409544
    m_Localized: "Не удалось загрузить список лобби. Попробуйте снова."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409545
    m_Localized: "Не удалось начать матч. Оба игрока должны быть подключены; попробуйте снова."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409546
    m_Localized: "Сначала выберите разыгранную карту в нижнем ряду."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409547
    m_Localized: "Выберите цель и нажмите «Подтвердить» перед «Отправить»."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409548
    m_Localized: "Сейчас ход соперника."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409549
    m_Localized: "Колода закончилась: перемешана новая колода."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409550
    m_Localized: "Все блоки соперника разрушены."
    m_Metadata:
      m_Items: []
  - m_Id: 50769044537409551
    m_Localized: "Все ваши блоки разрушены."
    m_Metadata:
      m_Items: []
  references:
